PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/matapp
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false

# DEMO or DARAJA
PAYMENT_MODE=DEMO

# For sandbox, create an app at https://developer.safaricom.co.ke and use sandbox credentials.
# For live payments, use production credentials only after Safaricom approval and sandbox testing.
# Never commit the populated .env file.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_TOKEN=replace_with_a_long_random_callback_token
MPESA_CALLBACK_URL=https://YOUR_PUBLIC_API_DOMAIN/api/payments/callback/replace_with_same_callback_token
MPESA_ACCOUNT_REFERENCE=MATAPP
MPESA_TRANSACTION_DESC=MatApp%20Seat%20Booking
